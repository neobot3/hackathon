# Copy to .env and adjust: cp .env.example .env
# Vite inlines VITE_* values into the static bundle at build time.
# Never put secrets here; anything below is visible to the browser.

VITE_APP_NAME=TechRep Scheduler

# Backend API (FastAPI). Must be listed in the backend CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000

# Authentication mode: "local" (hardcoded demo users) or "azure" (Entra ID SSO).
VITE_AUTH_MODE=local

# Azure Entra ID (used when VITE_AUTH_MODE=azure)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_AZURE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_AZURE_API_SCOPE=api://<api-client-id>/access_as_user
# App roles in the Entra app registration that map to UI roles.
VITE_AZURE_ADMIN_ROLE=TechRep.Admin
VITE_AZURE_SCHEDULER_ROLE=TechRep.Scheduler
