# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env.

# Database
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techrep
DB_USER=techrep
DB_PASSWORD=change-me
# Optional full URL. If set, it replaces all DB_* values above.
# DATABASE_URL=postgresql+psycopg2://techrep:change-me@localhost:5432/techrep
# Log every SQL statement (true/false)
DB_ECHO=false

# Solver
SOLVER_MAX_SECONDS=10

# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
